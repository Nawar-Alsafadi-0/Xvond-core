    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers || {};\nconst body = item.body || item;\nconst supplied = headers['x-xvond-n8n-secret'] || headers['X-Xvond-N8N-Secret'];\nconst expected = $env.N8N_SHARED_SECRET;\nconst required = ['company_id','agent_id','channel_id','channel_type','external_contact_id','external_message_id','message'];\nconst missing = required.filter((key) => body[key] === undefined || body[key] === null || String(body[key]).trim() === '');\nif (!expected || supplied !== expected) {\n  return [{json:{success:false,_dispatch:'reject',error:'Unauthorized channel workflow request',code:'unauthorized'}}];\n}\nif (missing.length) {\n  return [{json:{success:false,_dispatch:'reject',error:'Invalid normalized channel message',code:'invalid_contract',missing}}];\n}\nreturn [{json:{\n  success:true,\n  _dispatch:'xvond',\n  request_id:String(body.request_id || body.external_message_id),\n  payload:{\n    company_id:Number(body.company_id),\n    agent_id:Number(body.agent_id),\n    channel_id:Number(body.channel_id),\n    channel_type:String(body.channel_type),\n    external_contact_id:String(body.external_contact_id),\n    external_message_id:String(body.external_message_id),\n    message:String(body.message)\n  }\n}}];"
      },
      "id": "validate-channel-inbound",
      "name": "Validate Normalized Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
