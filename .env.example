APP_NAME=Xvond Core
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# TEMPLATE ONLY: production deployment refuses the placeholder values in this file.
# Replace every GENERATE_*, CHANGE_TO_*, URL_ENCODED_PASSWORD and example admin value.

# Local Windows/Python runtime.
DATABASE_URL=postgresql+psycopg://xvond:URL_ENCODED_PASSWORD@127.0.0.1:5432/xvond

# Public HTTPS origin used by production channels and widget embed code.
# Production requires this value. Xvond's intended API hostname is api.xvond.com.
PUBLIC_BASE_URL=https://api.xvond.com
MEDIA_STORAGE_DIR=/var/lib/xvond/media
MEDIA_PUBLIC_TTL_SECONDS=7200
IMAGE_GENERATION_MODEL=gpt-image-2.5-flare

# Vapi private server API key for live Voice Agent provisioning.
# Keep the real value only in the server environment; never commit it.
VAPI_API_KEY=

# Meta WhatsApp Embedded Signup. Keep secrets only in the server environment.
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_REDIRECT_URI=
# Leave the following two values empty for standard WhatsApp Embedded Signup.
# Set them only when the Meta configuration explicitly uses WhatsApp Business
# App onboarding/coexistence and requires these login extras.
META_WHATSAPP_FEATURE_TYPE=
META_WHATSAPP_SESSION_INFO_VERSION=

# Xvond -> workflow engine gateway.
# The engine vendor stays internal; Xvond surfaces only Workflow Engine terminology.
# When Xvond and the engine run in the same Compose project, use the private Docker URL below.
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://workflow-engine:5678/webhook/xvond-actions
N8N_SHARED_SECRET=GENERATE_A_LONG_RANDOM_WORKFLOW_SHARED_SECRET
N8N_TIMEOUT_SECONDS=15
N8N_MAX_RETRIES=1

# Self-Service online billing. Keep disabled until the chosen provider has
# live credentials and the verified webhook/redirect paths are accepted.
# Xvond is provider-neutral. Tap is the intended Gulf/Oman production provider.
BILLING_PROVIDER=none

# Tap Payments hosted checkout.
TAP_SECRET_KEY=
TAP_MERCHANT_ID=
TAP_SOURCE_ID=src_all
# Enable only when Tap has activated Save Card / recurring capability on the merchant.
TAP_SAVE_CARD_FOR_RECURRING=false
# Keep false until Tap explicitly enables Save Card/recurring for the merchant.
TAP_RECURRING_ENABLED=false
# Attempt renewal this many hours before period expiry; bounded to 0..168.
TAP_RENEWAL_LEAD_HOURS=24
# Optional; defaults to PUBLIC_BASE_URL/billing/return.
TAP_REDIRECT_URL=

# Optional Paddle adapter retained as a fallback.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Public client-side token used by Paddle.js. Safe for the browser; never put the Paddle API key here.
PADDLE_CLIENT_TOKEN=
# Xvond-hosted checkout page approved in Paddle, for example https://api.xvond.com/checkout
PADDLE_CHECKOUT_URL=
# Map Xvond plan id or lowercase tier to a Paddle recurring price id.
# Example: {"starter":"pri_...","pro":"pri_...","3":"pri_..."}
PADDLE_PRICE_MAP_JSON={}
PADDLE_WEBHOOK_TOLERANCE_SECONDS=30

# Workflow Engine -> Xvond native execution callback.
# Keep this on the private Compose network in production.
XVOND_INTERNAL_ACTION_URL=http://app:8000/internal/workflow/xvond-internal
XVOND_INTERNAL_CHANNEL_URL=http://app:8000/internal/channels/message
XVOND_INTERNAL_CHANNEL_CONFIRM_URL=http://app:8000/internal/channels/delivery-confirmed

# Workflow-owned external integration registry.
# Keep the real JSON only in deployment secrets/environment, never in Git.
# Keys use "company_id:integration_id". Example shape is documented in ops/n8n/CONNECTED_INTEGRATIONS.md.
XVOND_WORKFLOW_INTEGRATIONS_JSON=

# Xvond-managed communication-channel routes.
# Keys use "company_id:connection_key". Provider credentials remain inside the
# workflow engine/provider workflow, never in Xvond Core.
XVOND_CHANNEL_ROUTES_JSON=
# Telegram provider routing. Keys match company_id:connection_key.
# Keep bot tokens and webhook/provider secrets only in the workflow engine environment.
# Example:
# {"1:telegram-main":{"company_id":1,"agent_id":12,"channel_id":34,"bot_token":"123:ABC","webhook_secret":"random-secret","provider_secret":"route-secret"}}
XVOND_TELEGRAM_ROUTES_JSON=

# Instagram DM / Facebook Messenger provider routes.
# Keys use company_id:connection_key. Keep access tokens/app secrets in the
# workflow plane only.
# Example Instagram:
# {"1:instagram-main":{"company_id":1,"agent_id":12,"channel_id":35,"channel_type":"instagram","sender_id":"1784...","graph_version":"v26.0","access_token":"...","app_secret":"...","provider_secret":"..."}}
# Example Messenger:
# {"1:messenger-main":{"company_id":1,"agent_id":12,"channel_id":36,"channel_type":"messenger","sender_id":"1234...","graph_version":"v26.0","access_token":"...","app_secret":"...","provider_secret":"..."}}
XVOND_META_MESSAGING_ROUTES_JSON=
XVOND_SLACK_ROUTES_JSON=
XVOND_META_MESSAGING_VERIFY_TOKEN=

# Self-hosted workflow engine runtime.
# Deliberately pinned. Upgrade only after staging + Workflow acceptance; never use a floating/latest tag in production.
WORKFLOW_ENGINE_VERSION=2.36.9
WORKFLOW_DB_USER=xvond_workflow
WORKFLOW_DB_PASSWORD=CHANGE_TO_A_SEPARATE_STRONG_WORKFLOW_DATABASE_PASSWORD
WORKFLOW_DB_NAME=xvond_workflow
WORKFLOW_ENCRYPTION_KEY=GENERATE_A_SEPARATE_LONG_WORKFLOW_ENCRYPTION_KEY
WORKFLOW_HOST=workflow.xvond.com
WORKFLOW_PUBLIC_URL=https://workflow.xvond.com/
WORKFLOW_PORT=5678
WORKFLOW_TIMEZONE=Asia/Muscat

# Production Compose runtime. The database hostname must remain "postgres".
DATABASE_URL_DOCKER=postgresql+psycopg://xvond:URL_ENCODED_PASSWORD@postgres:5432/xvond
POSTGRES_USER=xvond
POSTGRES_PASSWORD=CHANGE_TO_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=xvond
POSTGRES_PORT=5432
APP_PORT=8000
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Optional encrypted off-server backups via Restic.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=GENERATE_A_SEPARATE_LONG_BACKUP_ENCRYPTION_PASSWORD
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
OFFSITE_BACKUP_INTERVAL_SECONDS=86400
OFFSITE_KEEP_DAILY=14
OFFSITE_KEEP_WEEKLY=8
OFFSITE_KEEP_MONTHLY=12

REDIS_URL=redis://127.0.0.1:6379/0
# Production Core is intentionally bound to 127.0.0.1 and reached through the
# repository-managed Nginx reverse proxy. Trust its forwarded client IP so rate
# limits and request logs do not collapse every customer into 127.0.0.1.
TRUST_PROXY_HEADERS=true
# Signed website visitor token lifetime. Default 30 days so the same browser can restore its chat.
WEBSITE_VISITOR_TOKEN_TTL_SECONDS=2592000
WHATSAPP_HUMAN_HANDOFF_MINUTES=60
# Keep enabled unless a controlled environment has a documented reason to disable it.
AI_PII_REDACTION_ENABLED=true

JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=xvond-core
JWT_AUDIENCE=xvond-users
ACCESS_TOKEN_EXPIRE_MINUTES=60

CONFIG_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_TO_A_STRONG_ADMIN_PASSWORD
SUPERADMIN_FULL_NAME=Xvond Super Admin

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Google Calendar OAuth for Self-Service booking connections.
# Register the exact callback URI in Google Cloud OAuth credentials.
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
# Example: https://api.xvond.com/customer/agents/manage/integrations/google-calendar/oauth/callback
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=

# Hybrid Knowledge retrieval. When enabled and OPENAI_API_KEY is configured,
# Xvond stores real embeddings for Knowledge chunks and combines semantic
# similarity with the deterministic lexical/intent scorer. If the embedding
# provider is unavailable, retrieval safely falls back to lexical matching.
KNOWLEDGE_SEMANTIC_ENABLED=true
KNOWLEDGE_EMBEDDING_PROVIDER=openai
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_SEMANTIC_MIN_SIMILARITY=0.35
KNOWLEDGE_SEMANTIC_WEIGHT=20

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=